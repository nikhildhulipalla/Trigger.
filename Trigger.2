1.

CREATE DATABASE BankingDB;
USE BankingDB;

CREATE TABLE Accounts (
    account_number INT PRIMARY KEY,
    balance DECIMAL(12,2) NOT NULL
);

CREATE TABLE Transactions (
    transaction_id INT AUTO_INCREMENT PRIMARY KEY,
    account_number INT NOT NULL,
    transaction_type VARCHAR(10),
    amount DECIMAL(12,2),
    transaction_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (account_number)
        REFERENCES Accounts(account_number)
);

CREATE TABLE Products (
    product_id INT PRIMARY KEY,
    name VARCHAR(100),
    stock_quantity INT NOT NULL
);

CREATE TABLE Sales (
    sale_id INT PRIMARY KEY,
    product_id INT NOT NULL,
    quantity_sold INT NOT NULL,
    sale_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id)
        REFERENCES Products(product_id)
);

CREATE TABLE Departments (
    dept_id INT PRIMARY KEY,
    name VARCHAR(100),
    employee_count INT DEFAULT 0
);

CREATE TABLE Employees (
    emp_id INT PRIMARY KEY,
    name VARCHAR(100),
    salary DECIMAL(10,2) NOT NULL,
    dept_id INT,
    FOREIGN KEY (dept_id)
        REFERENCES Departments(dept_id)
);

CREATE TABLE Students (
    student_id INT PRIMARY KEY,
    name VARCHAR(100),
    marks DECIMAL(5,2) NOT NULL
);


2.
DELIMITER //

CREATE TRIGGER account_update_trigger
AFTER UPDATE ON Accounts
FOR EACH ROW
BEGIN
    IF NEW.balance > OLD.balance THEN
        INSERT INTO Transactions
            (account_number, transaction_type, amount, transaction_date)
        VALUES
            (NEW.account_number, 'CREDIT',
             ABS(NEW.balance - OLD.balance), CURRENT_TIMESTAMP);

    ELSEIF NEW.balance < OLD.balance THEN
        INSERT INTO Transactions
            (account_number, transaction_type, amount, transaction_date)
        VALUES
            (NEW.account_number, 'DEBIT',
             ABS(NEW.balance - OLD.balance), CURRENT_TIMESTAMP);
    END IF;
END //

DELIMITER ;

3.
DELIMITER //

CREATE TRIGGER sales_insert_trigger
AFTER INSERT ON Sales
FOR EACH ROW
BEGIN
    UPDATE Products
    SET stock_quantity = stock_quantity - NEW.quantity_sold
    WHERE product_id = NEW.product_id;
END //

DELIMITER ;

4.
DELIMITER //

CREATE TRIGGER salary_validation_trigger
BEFORE UPDATE ON Employees
FOR EACH ROW
BEGIN
    IF NEW.salary <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Salary must be greater than zero';
    END IF;
END //

DELIMITER ;

5.
DELIMITER //

CREATE TRIGGER marks_validation_trigger
BEFORE INSERT ON Students
FOR EACH ROW
BEGIN
    IF NEW.marks < 0 OR NEW.marks > 100 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Marks must be between 0 and 100';
    END IF;
END //

DELIMITER ;

6.
DELIMITER //

CREATE TRIGGER employee_insert_trigger
AFTER INSERT ON Employees
FOR EACH ROW
BEGIN
    UPDATE Departments
    SET employee_count = employee_count + 1
    WHERE dept_id = NEW.dept_id;
END //

DELIMITER ;

7.
DELIMITER //

CREATE TRIGGER employee_delete_trigger
AFTER DELETE ON Employees
FOR EACH ROW
BEGIN
    UPDATE Departments
    SET employee_count = employee_count - 1
    WHERE dept_id = OLD.dept_id;
END //

DELIMITER ;

